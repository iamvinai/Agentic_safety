# Copy this file to .env and add your keys.
# Keep .env private.
RADWARE_OUT_OF_PATH_API_KEY=
GOOGLE_API_KEY=
# GEMINI_API_KEY= also works if you prefer that name.
GEMINI_API_KEY=

# This is the tested model for the current app.
GEMINI_MODEL=gemini-3.6-flash
RADWARE_USER_IDENTIFIER=securedesk-gemini-demo
RADWARE_FAIL_MODE=close
RADWARE_TIMEOUT_S=90
